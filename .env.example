# Copier ce fichier en `.env`, puis renseigner les clés.
# `.env` n'est jamais versionné : ne mettez aucun secret dans ce fichier-ci.
# Une clé laissée vide désactive simplement le service correspondant.

# Modèle de langage payant — rédaction des lettres de motivation.
ANTHROPIC_API_KEY=

# Modèles de langage gratuits — tri des offres et relecture des lettres.
GROQ_API_KEY=
GEMINI_API_KEY=

# Pré-filtrage facultatif, avant le tri par modèle de langage.
JEVMODEL_API_KEY=

# Source d'offres facultative : identifiants d'une application déclarée sur
# le portail développeur de France Travail (distinct de l'espace candidat).
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
